# EasyEats backend — docker-compose environment template.
#
# Copy to `.env` (which is git-ignored) and fill in real values:
#     cp .env.example .env
#
# NEVER put real secrets in this file — it is committed to git.

# --- MongoDB Atlas -----------------------------------------------------------
# One connection string per database. Format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ : / ? # [ ] %).
MONGO_URI_USERS=
MONGO_URI_ORDERS=
MONGO_URI_RESTAURANTS=
MONGO_URI_NOTIFICATIONS=
MONGO_URI_PAYMENTS=
MONGO_URI_DELIVERY=

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Cloudinary (restaurant image uploads) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail app password, not the account password) --------------------
EMAIL_USER=
EMAIL_PASSWORD=

# --- Twilio SMS --------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
